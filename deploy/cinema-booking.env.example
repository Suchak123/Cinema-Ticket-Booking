# Environment configuration for the cinema-booking service.
#
# Deploy:  sudo cp deploy/cinema-booking.env.example /etc/cinema-booking.env
# then edit the values below and:
#   sudo systemctl restart cinema-booking
#
# Format is systemd EnvironmentFile syntax: KEY=value, one per line,
# no quotes, no `export`. Lines starting with # are comments.

# Address of the Redis server (host:port, no redis:// scheme).
REDIS_ADDR=localhost:6379

# Address the HTTP server binds to (host:port; empty host = all interfaces).
LISTEN_ADDR=:8080
